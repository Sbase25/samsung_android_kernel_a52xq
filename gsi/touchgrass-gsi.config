# Mirror of arch/arm64/configs/vendor/samsung/touchgrass-gsi.config
# (kept here too for visibility; the build uses the one under arch/)
CONFIG_LOCALVERSION="-touchGrass"
# CONFIG_LOCALVERSION_AUTO is not set
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y
CONFIG_OVERLAY_FS=y
CONFIG_EROFS_FS=y
CONFIG_ANDROID_BINDERFS=y
CONFIG_BPF_SYSCALL=y
CONFIG_BPF_JIT=y
CONFIG_CGROUP_BPF=y
CONFIG_PSI=y
CONFIG_MEMCG=y
