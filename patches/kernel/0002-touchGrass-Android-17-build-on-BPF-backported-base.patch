diff --git a/arch/arm64/configs/vendor/samsung/touchgrass-a17.config b/arch/arm64/configs/vendor/samsung/touchgrass-a17.config
new file mode 100644
index 000000000..222f38c81
--- /dev/null
+++ b/arch/arm64/configs/vendor/samsung/touchgrass-a17.config
@@ -0,0 +1,11 @@
+#
+# touchGrassKernel - Android 17 (LineageOS 24) compat fragment. Apply after touchgrass-ebpf.config.
+# Mirrors what official LineageOS 24.0 enables on the 4.19 S20 FE (r8q) kernel.
+#
+CONFIG_LOCALVERSION="-touchGrass-a17"
+# ashmem ioctls on memfd: Android 17 hands out memfds, old Samsung HALs still speak ashmem
+CONFIG_MEMFD_CREATE=y
+CONFIG_ASHMEM=y
+CONFIG_MEMFD_ASHMEM_SHIM=y
+# ART userfaultfd (CMC) garbage collector
+CONFIG_USERFAULTFD=y
diff --git a/arch/arm64/configs/vendor/samsung/touchgrass-ebpf.config b/arch/arm64/configs/vendor/samsung/touchgrass-ebpf.config
new file mode 100644
index 000000000..0041bce49
--- /dev/null
+++ b/arch/arm64/configs/vendor/samsung/touchgrass-ebpf.config
@@ -0,0 +1,23 @@
+#
+# touchGrassKernel - eBPF fragment for newer AOSP/LineageOS GSIs (Android 16/17 netd, bpfloader, tethering offload)
+# Apply AFTER touchgrass-gsi.config.
+#
+CONFIG_LOCALVERSION="-touchGrass-ebpf"
+# core
+CONFIG_BPF=y
+CONFIG_BPF_SYSCALL=y
+CONFIG_BPF_JIT=y
+CONFIG_BPF_JIT_ALWAYS_ON=y
+CONFIG_BPF_EVENTS=y
+CONFIG_CGROUP_BPF=y
+# tc / clsact (clatd + tethering offload attach BPF on ingress/egress)
+CONFIG_NET_SCH_INGRESS=y
+CONFIG_NET_CLS_ACT=y
+CONFIG_NET_CLS_BPF=y
+CONFIG_NET_ACT_BPF=y
+# netfilter bpf match (bandwidth/traffic control)
+CONFIG_NETFILTER_XT_MATCH_BPF=y
+CONFIG_NETFILTER_XT_MATCH_OWNER=y
+# sockmap / stream parser + AF_XDP
+# CONFIG_BPF_STREAM_PARSER is not set
+CONFIG_XDP_SOCKETS=y
diff --git a/arch/arm64/configs/vendor/samsung/touchgrass-gsi.config b/arch/arm64/configs/vendor/samsung/touchgrass-gsi.config
new file mode 100644
index 000000000..77ea976f8
--- /dev/null
+++ b/arch/arm64/configs/vendor/samsung/touchgrass-gsi.config
@@ -0,0 +1,15 @@
+#
+# touchGrassKernel - AOSP/LineageOS 23.2 (Android 16 QPR2) GSI fragment for a52xq
+#
+CONFIG_LOCALVERSION="-touchGrass"
+# CONFIG_LOCALVERSION_AUTO is not set
+CONFIG_IKCONFIG=y
+CONFIG_IKCONFIG_PROC=y
+CONFIG_OVERLAY_FS=y
+CONFIG_EROFS_FS=y
+CONFIG_ANDROID_BINDERFS=y
+CONFIG_BPF_SYSCALL=y
+CONFIG_BPF_JIT=y
+CONFIG_CGROUP_BPF=y
+CONFIG_PSI=y
+CONFIG_MEMCG=y
diff --git a/mm/Kconfig b/mm/Kconfig
index de3c052fc..5d0dc1617 100755
--- a/mm/Kconfig
+++ b/mm/Kconfig
@@ -893,6 +893,18 @@ config MAX_DIRTY_THRESH_PAGES
 	  It is only effective when dirty_ratio is used.
 	  (Setting dirty_bytes disables this option.)
 
+
+config MEMFD_ASHMEM_SHIM
+	bool "Memfd ashmem ioctl compatibility support"
+	depends on MEMFD_CREATE
+	help
+	  This provides compatibility support for ashmem ioctl commands against
+	  memfd file descriptors. This is useful for compatibility on Android
+	  for older applications that may use ashmem's ioctl commands on the
+	  now memfds passed to them.
+
+	  Unless you are running Android, say N.
+
 endmenu
 
 config PROCESS_RECLAIM
