From 51c7c59462b1e4466ddc2b5dd318969b1a74c3da Mon Sep 17 00:00:00 2001
From: Stijn <sbaselmans1@gmail.com>
Date: Mon, 2 Nov 2026 08:21:32 +0100
Subject: [PATCH 4/4] Rename touchGrass kernel to Overgrowth

Config fragments become overgrowth-{gsi,ebpf,a17}.config, LOCALVERSION
is -Overgrowth and the seccomp log tag follows the new name.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01KfdEw7FqSm92uoQmEa9GaX
---
 .../{touchgrass-a17.config => overgrowth-a17.config}        | 4 ++--
 .../{touchgrass-ebpf.config => overgrowth-ebpf.config}      | 6 +++---
 .../{touchgrass-gsi.config => overgrowth-gsi.config}        | 4 ++--
 kernel/seccomp.c                                            | 4 ++--
 4 files changed, 9 insertions(+), 9 deletions(-)
 rename arch/arm64/configs/vendor/samsung/{touchgrass-a17.config => overgrowth-a17.config} (68%)
 rename arch/arm64/configs/vendor/samsung/{touchgrass-ebpf.config => overgrowth-ebpf.config} (72%)
 rename arch/arm64/configs/vendor/samsung/{touchgrass-gsi.config => overgrowth-gsi.config} (66%)

diff --git a/arch/arm64/configs/vendor/samsung/touchgrass-a17.config b/arch/arm64/configs/vendor/samsung/overgrowth-a17.config
similarity index 68%
rename from arch/arm64/configs/vendor/samsung/touchgrass-a17.config
rename to arch/arm64/configs/vendor/samsung/overgrowth-a17.config
index 222f38c81..1b0e292b4 100644
--- a/arch/arm64/configs/vendor/samsung/touchgrass-a17.config
+++ b/arch/arm64/configs/vendor/samsung/overgrowth-a17.config
@@ -1,8 +1,8 @@
 #
-# touchGrassKernel - Android 17 (LineageOS 24) compat fragment. Apply after touchgrass-ebpf.config.
+# Overgrowth kernel - Android 17 (LineageOS 24) compat fragment. Apply after overgrowth-ebpf.config.
 # Mirrors what official LineageOS 24.0 enables on the 4.19 S20 FE (r8q) kernel.
 #
-CONFIG_LOCALVERSION="-touchGrass-a17"
+CONFIG_LOCALVERSION="-Overgrowth"
 # ashmem ioctls on memfd: Android 17 hands out memfds, old Samsung HALs still speak ashmem
 CONFIG_MEMFD_CREATE=y
 CONFIG_ASHMEM=y
diff --git a/arch/arm64/configs/vendor/samsung/touchgrass-ebpf.config b/arch/arm64/configs/vendor/samsung/overgrowth-ebpf.config
similarity index 72%
rename from arch/arm64/configs/vendor/samsung/touchgrass-ebpf.config
rename to arch/arm64/configs/vendor/samsung/overgrowth-ebpf.config
index 0041bce49..cda517042 100644
--- a/arch/arm64/configs/vendor/samsung/touchgrass-ebpf.config
+++ b/arch/arm64/configs/vendor/samsung/overgrowth-ebpf.config
@@ -1,8 +1,8 @@
 #
-# touchGrassKernel - eBPF fragment for newer AOSP/LineageOS GSIs (Android 16/17 netd, bpfloader, tethering offload)
-# Apply AFTER touchgrass-gsi.config.
+# Overgrowth kernel - eBPF fragment for newer AOSP/LineageOS GSIs (Android 16/17 netd, bpfloader, tethering offload)
+# Apply AFTER overgrowth-gsi.config.
 #
-CONFIG_LOCALVERSION="-touchGrass-ebpf"
+CONFIG_LOCALVERSION="-Overgrowth"
 # core
 CONFIG_BPF=y
 CONFIG_BPF_SYSCALL=y
diff --git a/arch/arm64/configs/vendor/samsung/touchgrass-gsi.config b/arch/arm64/configs/vendor/samsung/overgrowth-gsi.config
similarity index 66%
rename from arch/arm64/configs/vendor/samsung/touchgrass-gsi.config
rename to arch/arm64/configs/vendor/samsung/overgrowth-gsi.config
index 77ea976f8..9b282cc83 100644
--- a/arch/arm64/configs/vendor/samsung/touchgrass-gsi.config
+++ b/arch/arm64/configs/vendor/samsung/overgrowth-gsi.config
@@ -1,7 +1,7 @@
 #
-# touchGrassKernel - AOSP/LineageOS 23.2 (Android 16 QPR2) GSI fragment for a52xq
+# Overgrowth kernel - AOSP/LineageOS 23.2 (Android 16 QPR2) GSI fragment for a52xq
 #
-CONFIG_LOCALVERSION="-touchGrass"
+CONFIG_LOCALVERSION="-Overgrowth"
 # CONFIG_LOCALVERSION_AUTO is not set
 CONFIG_IKCONFIG=y
 CONFIG_IKCONFIG_PROC=y
diff --git a/kernel/seccomp.c b/kernel/seccomp.c
index 63128e822..0fdda5185 100755
--- a/kernel/seccomp.c
+++ b/kernel/seccomp.c
@@ -675,7 +675,7 @@ static int __seccomp_filter(int this_syscall, const struct seccomp_data *sd,
 	action = filter_ret & SECCOMP_RET_ACTION_FULL;
 
 	/*
-	 * touchGrass: Samsung's Android 11 codec2 service ships a seccomp
+	 * Overgrowth: Samsung's Android 11 codec2 service ships a seccomp
 	 * policy that predates syscalls used by newer bionic (e.g. rseq),
 	 * so on Android 16 GSIs it is killed at startup.  Only for that
 	 * process, log the blocked syscall and allow it instead of killing.
@@ -683,7 +683,7 @@ static int __seccomp_filter(int this_syscall, const struct seccomp_data *sd,
 	if ((action == SECCOMP_RET_TRAP || action == SECCOMP_RET_KILL_THREAD ||
 	     action == SECCOMP_RET_KILL_PROCESS) && current->group_leader &&
 	    !strncmp(current->group_leader->comm, "samsung.softwar", 15)) {
-		pr_info_ratelimited("touchGrass: seccomp allow syscall %d for %s\n",
+		pr_info_ratelimited("Overgrowth: seccomp allow syscall %d for %s\n",
 				    this_syscall, current->group_leader->comm);
 		action = SECCOMP_RET_ALLOW;
 	}
-- 
2.43.0

