+
+static const struct ksu_feature_handler *feature_handlers[KSU_FEATURE_MAX];
+
+static DEFINE_MUTEX(feature_mutex);
+
+static const char *const feature_names[KSU_FEATURE_MAX] = {
+	[KSU_FEATURE_SU_COMPAT] = "su_compat",
+	[KSU_FEATURE_KERNEL_UMOUNT] = "kernel_umount",
+	[KSU_FEATURE_SULOG] = "sulog",
+	[KSU_FEATURE_ADB_ROOT] = "adb_root",
+	[KSU_FEATURE_SELINUX_HIDE] = "selinux_hide",
+	[KSU_FEATURE_SHELL_SU_ADB_ONLY] = "shell_su_adb_only",
+	[KSU_FEATURE_AVC_SPOOF] = "avc_spoof",
+};
+
+// Features forced by boot config. Written only while parsing module params
+// (before kernelsu_init), read-only afterwards.
+static u64 forced_values[KSU_FEATURE_MAX];
+static DECLARE_BITMAP(forced_mask, KSU_FEATURE_MAX);
+static DECLARE_BITMAP(forced_pending, KSU_FEATURE_MAX);
+
+static int parse_feature_id(const char *name, u32 *id)
+{
+	u32 i;
+
+	if (!kstrtou32(name, 10, id)) {
+		return *id < KSU_FEATURE_MAX ? 0 : -EINVAL;
+	}
+
+	for (i = 0; i < KSU_FEATURE_MAX; i++) {
+		if (feature_names[i] && !strcmp(name, feature_names[i])) {
+			*id = i;
+			return 0;
+		}
+	}
+
+	return -EINVAL;
+}
+
+// force_feature=<name|id>:<value>[,<name|id>:<value>...]
+// May be specified multiple times. Invalid entries are skipped instead of
+// failing, as a param error would prevent KernelSU from loading at all.
+// This may run before the slab allocator is up (built-in), so don't allocate.
+static int force_feature_param_set(const char *val, const struct kernel_param *kp)
+{
+	char name[32], num[24];
+	const char *p = val, *end, *sep;
+	size_t name_len, num_len;
+	u32 id;
+	u64 value;
+
+	if (!val) {
+		return 0;
+	}
+
+	for (; *p; p = end ? end + 1 : end) {
+		end = strchrnul(p, ',');
+		if (end == p) {
+			continue;
+		}
+
+		sep = memchr(p, ':', end - p);
+		name_len = sep ? sep - p : 0;
+		num_len = sep ? end - sep - 1 : 0;
+		if (!name_len || name_len >= sizeof(name) || !num_len || num_len >= sizeof(num)) {
+			pr_err("feature: invalid force_feature entry '%.*s'\n", (int)(end - p), p);
+			continue;
+		}
+
+		memcpy(name, p, name_len);
+		name[name_len] = '\0';
+		memcpy(num, sep + 1, num_len);
+		num[num_len] = '\0';
+
+		if (parse_feature_id(name, &id) || kstrtou64(num, 0, &value)) {
+			pr_err("feature: invalid force_feature entry '%s:%s'\n", name, num);
+			continue;
+		}
+
+		forced_values[id] = value;
+		set_bit(id, forced_mask);
+		set_bit(id, forced_pending);
+		pr_info("feature: %s (id=%u) forced to %llu\n", feature_names[id], id, value);
+	}
+
+	return 0;
+}
+
+static const struct kernel_param_ops force_feature_param_ops = {
+	.flags = KERNEL_PARAM_OPS_FL_NOARG,
+	.set = force_feature_param_set,
+};
+module_param_cb(force_feature, &force_feature_param_ops, NULL, 0);
+
+int ksu_register_feature_handler(const struct ksu_feature_handler *handler)
+{
+	if (!handler) {
+		pr_err("feature: register handler is NULL\n");
+		return -EINVAL;
+	}
+
+	if (handler->feature_id >= KSU_FEATURE_MAX) {
+		pr_err("feature: invalid feature_id %u\n", handler->feature_id);
+		return -EINVAL;
+	}
+
+	if (!handler->get_handler && !handler->set_handler) {
+		pr_err("feature: no handler provided for feature %u\n", handler->feature_id);
+		return -EINVAL;
+	}
+
+	mutex_lock(&feature_mutex);
+
+	if (feature_handlers[handler->feature_id]) {
+		pr_warn("feature: handler for %u already registered, overwriting\n",
+		handler->feature_id);
+	}
+
+	feature_handlers[handler->feature_id] = handler;
+
+	pr_info("feature: registered handler for %s (id=%u)\n",
+		handler->name ? handler->name : "unknown", handler->feature_id);
+
+	mutex_unlock(&feature_mutex);
+	return 0;
+}
+
+int ksu_unregister_feature_handler(u32 feature_id)
+{
+	int ret = 0;
+
+	if (feature_id >= KSU_FEATURE_MAX) {
+		pr_err("feature: invalid feature_id %u\n", feature_id);
+		return -EINVAL;
+	}
+
+	mutex_lock(&feature_mutex);
+
+	if (!feature_handlers[feature_id]) {
+		pr_warn("feature: no handler registered for %u\n", feature_id);
+		ret = -ENOENT;
+		goto out;
+	}
+
+	feature_handlers[feature_id] = NULL;
+
+	pr_info("feature: unregistered handler for id=%u\n", feature_id);
+
+out:
+	mutex_unlock(&feature_mutex);
+	return ret;
+}
+
+int ksu_get_feature(u32 feature_id, u64 *value, bool *supported)
+{
+	int ret = 0;
+	const struct ksu_feature_handler *handler;
+
+	if (feature_id >= KSU_FEATURE_MAX) {
+		pr_err("feature: invalid feature_id %u\n", feature_id);
+		return -EINVAL;
+	}
+
+	if (!value || !supported) {
+		pr_err("feature: invalid parameters\n");
+		return -EINVAL;
+	}
+
+	mutex_lock(&feature_mutex);
+
+	handler = feature_handlers[feature_id];
+
+	if (!handler) {
+		*supported = false;
+		*value = 0;
+		pr_debug("feature: feature %u not supported\n", feature_id);
+		goto out;
+	}
+
+	*supported = true;
+
+	if (!handler->get_handler) {
+		pr_warn("feature: no get_handler for feature %u\n", feature_id);
+		ret = -EOPNOTSUPP;
+		goto out;
+	}
+
+	ret = handler->get_handler(value);
+	if (ret) {
+		pr_err("feature: get_handler for %u failed: %d\n", feature_id, ret);
+	}
+
+out:
+	mutex_unlock(&feature_mutex);
+	return ret;
+}
+
+int ksu_set_feature(u32 feature_id, u64 value)
+{
+	int ret = 0;
+	const struct ksu_feature_handler *handler;
+
+	if (feature_id >= KSU_FEATURE_MAX) {
+		pr_err("feature: invalid feature_id %u\n", feature_id);
+		return -EINVAL;
+	}
+
+	mutex_lock(&feature_mutex);
+
+	handler = feature_handlers[feature_id];
+
+	if (!handler) {
+		pr_err("feature: feature %u not registered\n", feature_id);
+		ret = -EOPNOTSUPP;
+		goto out;
+	}
+
+	if (!handler->set_handler) {
+		pr_warn("feature: no set_handler for feature %u\n", feature_id);
+		ret = -EOPNOTSUPP;
+		goto out;
+	}
+
+	if (test_bit(feature_id, forced_mask)) {
+		pr_warn("feature: feature %u is forced by boot config\n", feature_id);
+		ret = -EPERM;
+		goto out;
+	}
+
+	ret = handler->set_handler(value);
+	if (ret) {
+		pr_err("feature: set_handler for %u failed: %d\n", feature_id, ret);
+	}
+
+out:
+	mutex_unlock(&feature_mutex);
+	return ret;
+}
+
+void __init ksu_feature_init(void)
+{
+	int i;
+
+	for (i = 0; i < KSU_FEATURE_MAX; i++) {
+		feature_handlers[i] = NULL;
+	}
+
+	pr_info("feature: feature management initialized\n");
+}
+
+void __exit ksu_feature_exit(void)
+{
+	int i;
+
+	mutex_lock(&feature_mutex);
+
+	for (i = 0; i < KSU_FEATURE_MAX; i++) {
+		feature_handlers[i] = NULL;
+	}
+
+	mutex_unlock(&feature_mutex);
+
+	pr_info("feature: feature management cleaned up\n");
+}
+
+bool ksu_feature_is_forced(u32 feature_id)
+{
+	return feature_id < KSU_FEATURE_MAX && test_bit(feature_id, forced_mask);
+}
+
+void ksu_feature_apply_forced(void)
+{
+	const struct ksu_feature_handler *handler;
+	unsigned int id;
+	int ret;
+
+	mutex_lock(&feature_mutex);
+
+	for_each_set_bit (id, forced_pending, KSU_FEATURE_MAX) {
+		handler = feature_handlers[id];
+		if (!handler || !handler->set_handler) {
+			continue;
+		}
+
+		ret = handler->set_handler(forced_values[id]);
+		if (ret) {
+			pr_warn("feature: apply forced %s=%llu failed: %d\n",
+				feature_names[id], forced_values[id], ret);
+			continue;
+		}
+
+		clear_bit(id, forced_pending);
+	}
+
+	mutex_unlock(&feature_mutex);
+}
diff --git a/drivers/kernelsu/policy/feature.h b/drivers/kernelsu/policy/feature.h
new file mode 100644
index 000000000..a22543171
--- /dev/null
+++ b/drivers/kernelsu/policy/feature.h
@@ -0,0 +1,38 @@
+#ifndef __KSU_H_FEATURE
+#define __KSU_H_FEATURE
+
+#include <linux/types.h>
+#include "uapi/feature.h" // IWYU pragma: keep
+
+typedef int (*ksu_feature_get_t)(u64 *value);
+typedef int (*ksu_feature_set_t)(u64 value);
+
+struct ksu_feature_handler {
+	u32 feature_id;
+	const char *name;
+	ksu_feature_get_t get_handler;
+	ksu_feature_set_t set_handler;
+};
+
+int ksu_register_feature_handler(const struct ksu_feature_handler *handler);
+
+int ksu_unregister_feature_handler(u32 feature_id);
+
+int ksu_get_feature(u32 feature_id, u64 *value, bool *supported);
+
+int ksu_set_feature(u32 feature_id, u64 value);
+
+void ksu_feature_init(void);
+
+void ksu_feature_exit(void);
+
+// Whether the feature is forced by the force_feature module param, in which
+// case ksu_set_feature() refuses to change it.
+bool ksu_feature_is_forced(u32 feature_id);
+
+// Apply forced feature values not applied yet. Called at several boot stages
+// since some handlers can only succeed late (e.g. selinux_hide needs the
+// sepolicy backup).
+void ksu_feature_apply_forced(void);
+
+#endif // __KSU_H_FEATURE
diff --git a/drivers/kernelsu/preinit/blob.S b/drivers/kernelsu/preinit/blob.S
new file mode 100644
index 000000000..84ca6c733
--- /dev/null
+++ b/drivers/kernelsu/preinit/blob.S
@@ -0,0 +1,12 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+/*
+ * Embed the preinit runner. It is only needed until ksu_preinit_init() copies
+ * it into shmem, so keep it in an init section that is freed after load.
+ */
+	.section .init.rodata, "a"
+	.balign 16
+	.global ksu_preinit_runner_start
+ksu_preinit_runner_start:
+	.incbin KSU_PREINIT_RUNNER_BIN
+	.global ksu_preinit_runner_end
+ksu_preinit_runner_end:
diff --git a/drivers/kernelsu/preinit/preinit.c b/drivers/kernelsu/preinit/preinit.c
new file mode 100644
index 000000000..f93aa5e04
--- /dev/null
+++ b/drivers/kernelsu/preinit/preinit.c
@@ -0,0 +1,163 @@
+#include <linux/err.h>
+#include <linux/fcntl.h>
+#include <linux/file.h>
+#include <linux/fs.h>
+#include <linux/moduleparam.h>
+#include <linux/namei.h>
+#include <linux/sched.h>
+#include <linux/shmem_fs.h>
+#include <linux/string.h>
+#include <linux/uaccess.h>
+
+#include "klog.h" // IWYU pragma: keep
+#include "util.h"
+#include "preinit/preinit.h"
+#include "hook/syscall_table_hook.h"
+#include "infra/symbol_resolver.h"
+
+typedef long (*ksu_preinit_syscall_fn_t)(const struct pt_regs *);
+
+__weak ksu_preinit_syscall_fn_t *ksu_syscall_table;
+#define INIT_PATH "/system/bin/init"
+
+// The runner is a static ELF embedded into .init.rodata by preinit/blob.S.
+extern const char ksu_preinit_runner_start[];
+extern const char ksu_preinit_runner_end[];
+
+static bool ksu_preinit_enabled = true;
+module_param_named(preinit, ksu_preinit_enabled, bool, 0);
+
+// Owned here until PID 1 executes it; the init section holding the blob is
+// gone by then, so it lives in an unlinked shmem file.
+static struct file *ksu_preinit_file;
+
+void __init ksu_preinit_init(void)
+{
+    size_t size = ksu_preinit_runner_end - ksu_preinit_runner_start;
+    struct file *file;
+    loff_t pos = 0;
+    ssize_t written;
+
+    if (!ksu_preinit_enabled) {
+        pr_info("preinit: disabled\n");
+        return;
+    }
+
+    file = shmem_file_setup("ksu_preinit", size, 0);
+    if (IS_ERR(file)) {
+        pr_err("preinit: shmem_file_setup failed: %ld\n", PTR_ERR(file));
+        return;
+    }
+
+    written = kernel_write(file, ksu_preinit_runner_start, size, &pos);
+    if (written != size) {
+        pr_err("preinit: write runner failed: %zd\n", written);
+        fput(file);
+        return;
+    }
+
+    ksu_preinit_file = file;
+    pr_info("preinit: runner staged (%zu bytes)\n", size);
+}
+
+bool ksu_preinit_enabled_param(void)
+{
+    return ksu_preinit_enabled;
+}
+
+void ksu_preinit_release(void)
+{
+    struct file *file = xchg(&ksu_preinit_file, NULL);
+
+    if (file) {
+        pr_info("preinit: selinux_setup not seen, dropping runner\n");
+        fput(file);
+    }
+}
+
+void ksu_preinit_exit(void)
+{
+    ksu_preinit_release();
+}
+
+static bool is_selinux_setup(const char __user *const __user *argv_user)
+{
+    static const char expected[] = "selinux_setup";
+    const char __user *arg;
+    char buf[sizeof(expected) + 1];
+
+    if (!argv_user || get_user(arg, argv_user + 1) || !arg)
+        return false;
+
+    memset(buf, 0, sizeof(buf));
+    if (strncpy_from_user(buf, arg, sizeof(buf) - 1) < 0)
+        return false;
+
+    return !strcmp(buf, expected);
+}
+
+bool ksu_preinit_handle_execve(const char __user **filename_user, const char __user *const __user *argv_user,
+                               int orig_nr, struct pt_regs *regs, long *ret)
+{
+    const char __user *orig_filename;
+    char path[sizeof(INIT_PATH) + 1];
+    char fd_path[32];
+    struct file *file;
+    struct path p;
+    int fd, len;
+
+    if (likely(!READ_ONCE(ksu_preinit_file)))
+        return false;
+
+    if (!filename_user || !*filename_user)
+        return false;
+
+    memset(path, 0, sizeof(path));
+    if (strncpy_from_user(path, (const char __user *)untagged_addr((unsigned long)*filename_user), sizeof(path) - 1) <
+        0)
+        return false;
+
+    if (strcmp(path, INIT_PATH) || !is_selinux_setup(argv_user))
+        return false;
+
+    // One shot: the runner's own exec of the real init must pass through.
+    file = xchg(&ksu_preinit_file, NULL);
+    if (!file)
+        return false;
+
+    fd = get_unused_fd_flags(O_CLOEXEC);
+    if (fd < 0) {
+        pr_err("preinit: get fd failed: %d\n", fd);
+        fput(file);
+        return false;
+    }
+    // The fd owns the file from here on; close-on-exec frees it once the
+    // runner has been loaded.
+    fd_install(fd, file);
+
+    len = snprintf(fd_path, sizeof(fd_path), "/proc/self/fd/%d", fd);
+    if (kern_path(fd_path, LOOKUP_FOLLOW, &p)) {
+        pr_err("preinit: %s not reachable, booting without preinit\n", fd_path);
+        ksu_close_fd(fd);
+        return false;
+    }
+    path_put(&p);
+
+    orig_filename = *filename_user;
+    *filename_user = userspace_stack_buffer(fd_path, len + 1);
+    if (!*filename_user) {
+        *filename_user = orig_filename;
+        ksu_close_fd(fd);
+        return false;
+    }
+
+    pr_info("preinit: exec runner via %s\n", fd_path);
+    *ret = ksu_syscall_table[orig_nr](regs);
+    if (*ret < 0) {
+        pr_err("preinit: exec runner failed: %ld, booting without preinit\n", *ret);
+        *filename_user = orig_filename;
+        ksu_close_fd(fd);
+        *ret = ksu_syscall_table[orig_nr](regs);
+    }
+    return true;
+}
diff --git a/drivers/kernelsu/preinit/preinit.h b/drivers/kernelsu/preinit/preinit.h
new file mode 100644
index 000000000..34eb056bc
--- /dev/null
+++ b/drivers/kernelsu/preinit/preinit.h
@@ -0,0 +1,43 @@
+#ifndef __KSU_H_PREINIT
+#define __KSU_H_PREINIT
+
+#include <linux/types.h>
+#include <asm/ptrace.h>
+
+#ifndef KSU_NO_PREINIT
+void ksu_preinit_init(void);
+void ksu_preinit_exit(void);
+
+// Swap the runner in for PID 1's "/system/bin/init selinux_setup" execve.
+// Returns true when it issued the syscall itself; the result is in *ret.
+bool ksu_preinit_handle_execve(const char __user **filename_user, const char __user *const __user *argv_user,
+                               int orig_nr, struct pt_regs *regs, long *ret);
+
+// Drop the staged runner if selinux_setup was never seen.
+void ksu_preinit_release(void);
+
+// Whether the runner is built in and not disabled with preinit=0.
+bool ksu_preinit_enabled_param(void);
+#else
+static inline void ksu_preinit_init(void)
+{
+}
+static inline void ksu_preinit_exit(void)
+{
+}
+static inline bool ksu_preinit_handle_execve(const char __user **filename_user,
+                                             const char __user *const __user *argv_user, int orig_nr,
+                                             struct pt_regs *regs, long *ret)
+{
+    return false;
+}
+static inline void ksu_preinit_release(void)
+{
+}
+static inline bool ksu_preinit_enabled_param(void)
+{
+    return false;
+}
+#endif
+
+#endif // __KSU_H_PREINIT
