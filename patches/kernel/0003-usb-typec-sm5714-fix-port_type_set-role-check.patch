From ed0693f76a5e990da3859216b6d18b79b243e314 Mon Sep 17 00:00:00 2001
From: Stijn <sbaselmans1@gmail.com>
Date: Mon, 2 Nov 2026 08:37:40 +0100
Subject: [PATCH 3/3] usb: typec: sm5714: fix port_type_set role check

port_type_set() compared the current data role against TYPEC_PORT_DFP,
so a DRP request while attached as device (role 0 == DFP 0) forced the
port into host mode and broke adb/MTP. Compare the requested port_type
instead: SRC -> DFP, SNK -> UFP, others ignored (original behaviour,
without the enum-compare warning).

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01KfdEw7FqSm92uoQmEa9GaX
---
 drivers/usb/typec/sm/sm5714/sm5714_typec.c | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/drivers/usb/typec/sm/sm5714/sm5714_typec.c b/drivers/usb/typec/sm/sm5714/sm5714_typec.c
index f6f3a7d09..b4055edf1 100755
--- a/drivers/usb/typec/sm/sm5714/sm5714_typec.c
+++ b/drivers/usb/typec/sm/sm5714/sm5714_typec.c
@@ -1253,12 +1253,12 @@ static int sm5714_port_type_set(struct typec_port *port,
 		usbpd_data->typec_data_role, port_type);
 
 	reinit_completion(&usbpd_data->typec_reverse_completion);
-	if (usbpd_data->typec_data_role == TYPEC_PORT_DFP) {
+	if (port_type == TYPEC_PORT_SRC) {
 		pr_info("%s : try reversing, from UFP(Sink) to DFP(Source)\n",
 			__func__);
 		usbpd_data->typec_try_state_change = TRY_ROLE_SWAP_TYPE;
 		sm5714_rprd_mode_change(usbpd_data, TYPE_C_ATTACH_DFP);
-	} else if (usbpd_data->typec_data_role == TYPEC_PORT_UFP) {
+	} else if (port_type == TYPEC_PORT_SNK) {
 		pr_info("%s : try reversing, from DFP(Source) to UFP(Sink)\n",
 			__func__);
 #if IS_ENABLED(CONFIG_PDIC_NOTIFIER)
-- 
