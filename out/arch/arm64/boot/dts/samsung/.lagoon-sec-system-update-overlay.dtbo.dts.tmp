# 1 "../arch/arm64/boot/dts/samsung/a52/a52xq/../../lagoon-sec-system-update-overlay.dts"
# 1 "<built-in>" 1
# 1 "../arch/arm64/boot/dts/samsung/a52/a52xq/../../lagoon-sec-system-update-overlay.dts" 2
/dts-v1/;

/ {
 dtbo-version = <0x1>;

 fragment@0 {
  target = <0xffffffff>;

  __overlay__ {

   gpio_keys {

    vol_up {
     debounce-interval = <0xe>;
    };
   };
  };
 };

 __fixups__ {
  soc = "/fragment@0:target:0";
 };
};
