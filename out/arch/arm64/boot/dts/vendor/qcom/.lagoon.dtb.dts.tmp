       3200000 3200000>;

  qcom,sde-max-per-pipe-bw-high-kbps = <3200000 3200000
            3200000 3200000>;


  qcom,sde-sspp-clk-ctrl = <0x2ac 0>,
      <0x2ac 8>, <0x2b4 8>, <0x2c4 8>;
  qcom,sde-sspp-csc-off = <0x1a00>;
  qcom,sde-csc-type = "csc-10bit";
