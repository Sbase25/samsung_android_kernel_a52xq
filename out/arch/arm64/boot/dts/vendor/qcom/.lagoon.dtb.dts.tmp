     qcom,gpu-freq = <0>;
     qcom,bus-freq = <0>;
     qcom,bus-min = <0>;
     qcom,bus-max = <0>;
    };
   };

   qcom,gpu-pwrlevels-2 {
    #address-cells = <1>;
    #size-cells = <0>;
    qcom,speed-bin = <169>;
    qcom,ca-target-pwrlevel = <4>;
