  <129 512 150000 700000>,
  <90 585 75000 700000>,
  <1 676 0 55000>,
  <143 777 0 100>,


  <90 770 625000 1200000>,
  <129 512 625000 1100000>,
  <90 585 312500 1500000>,
  <1 676 0 134000>,
  <143 777 0 180>,


  <90 770 1250000 2400000>,
  <129 512 1250000 1800000>,
  <90 585 625000 3100000>,
  <1 676 0 223000>,
  <143 777 0 450>,


  <90 770 2000000 3500000>,
  <129 512 2000000 2000000>,
  <90 585 1000000 4100000>,
  <1 676 0 358000>,
  <143 777 0 550>;


  qcom,bus-vector-names =
   "MIN", "SVS2", "SVS", "NOMINAL", "TURBO";
  qcom,throughput-threshold = <310 600 1000>;
  qcom,scaling-exceptions = <>;


