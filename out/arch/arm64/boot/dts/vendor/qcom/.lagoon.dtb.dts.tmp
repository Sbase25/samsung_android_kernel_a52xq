  interrupt-names = "kgsl_3d0_irq";
  qcom,id = <0>;

  qcom,chipid = <0x06010900>;

  qcom,gpu-quirk-hfi-use-reg;
  qcom,gpu-quirk-secvid-set-once;


  qcom,idle-timeout = <80>;
  qcom,no-nap;

  qcom,highest-bank-bit = <14>;
  qcom,min-access-length = <32>;
  qcom,ubwc-mode = <2>;


  qcom,snapshot-size = <0x200000>;

  clocks = <&gpucc 16>,
   <&gpucc 13>,
   <&gcc 28>,
   <&gcc 45>,
   <&gpucc 10>;

  clock-names = "core_clk", "rbbmtimer_clk", "mem_clk",
    "mem_iface_clk", "gmu_clk";


  qcom,gpu-qdss-stm = <0x161c0000 0x40000>;

  #cooling-cells = <2>;
  qcom,tzone-names = "gpuss-0-usr", "gpuss-1-usr";


  qcom,gpubw-dev = <&gpubw>;
  qcom,bus-control;
  qcom,msm-bus,name = "grp3d";
  qcom,msm-bus,num-cases = <13>;
  qcom,msm-bus,num-paths = <1>;
  qcom,msm-bus,vectors-KBps =
    <26 512 0 0>,
    <26 512 0 400000>,
    <26 512 0 800000>,
    <26 512 0 1200000>,
    <26 512 0 1804800>,
    <26 512 0 2188000>,
    <26 512 0 2724000>,
    <26 512 0 3072000>,
    <26 512 0 4068000>,
    <26 512 0 5412000>,
    <26 512 0 6220000>,
    <26 512 0 7216000>,
    <26 512 0 8371200>;


  regulator-names = "vddcx", "vdd";

  vddcx-supply = <&gpu_cx_gdsc>;
  vdd-supply = <&gpu_gx_gdsc>;

  nvmem-cells = <&gpu_speed_bin>, <&gpu_gaming_bin>;
  nvmem-cell-names = "speed_bin", "gaming_bin";


  qcom,pm-qos-active-latency = <67>;
  qcom,pm-qos-wakeup-latency = <67>;


  qcom,enable-ca-jump;

  qcom,ca-busy-penalty = <12000>;


  operating-points-v2 = <&gpu_opp_table>;


  qcom,gpu-mempools {
   #address-cells = <1>;
