     qcom,gpu-freq = <430000000>;
     qcom,bus-freq = <8>;
     qcom,bus-min = <7>;
     qcom,bus-max = <10>;
    };


    qcom,gpu-pwrlevel@5 {
     reg = <5>;
     qcom,gpu-freq = <355000000>;
     qcom,bus-freq = <7>;
     qcom,bus-min = <5>;
     qcom,bus-max = <8>;
    };


    qcom,gpu-pwrlevel@6 {
     reg = <6>;
     qcom,gpu-freq = <253000000>;
     qcom,bus-freq = <5>;
     qcom,bus-min = <4>;
     qcom,bus-max = <7>;
    };


    qcom,gpu-pwrlevel@7 {
