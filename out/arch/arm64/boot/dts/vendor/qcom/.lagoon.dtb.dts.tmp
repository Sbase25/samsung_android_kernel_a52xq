  qcom,sde-ctl-off = <0x2000 0x2200 0x2400 0x2600>;
  qcom,sde-ctl-size = <0x1dc>;
  qcom,sde-ctl-display-pref = "primary", "none", "none", "none";

  qcom,sde-mixer-off = <0x45000 0x46000>;
