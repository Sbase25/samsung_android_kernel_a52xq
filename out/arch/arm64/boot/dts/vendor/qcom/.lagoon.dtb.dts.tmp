  qcom,sde-safe-lut-nrt = <0 0xffff>, <0 0xffff>;
  qcom,sde-safe-lut-cwb = <0 0x3ff>, <0x3ff>;


  qcom,sde-qos-lut-linear = <0 0x00112233 0x44556677>,
