 icnss: qcom,icnss@18800000 {
  compatible = "qcom,icnss";
  reg = <0x18800000 0x800000>,
        <0xb0000000 0x10000>;
  reg-names = "membase", "smmu_iova_ipa";
  iommus = <&apps_smmu 0x20 0x1>;
  interrupts = <0 414 4 >,
        <0 415 4 >,
