    iova-mem-region-io {
     iova-region-name = "io";
     iova-region-start = <0xd800000>;
     iova-region-len = <0xd2800000>;
     iova-region-id = <0x3>;
     status = "ok";
    };
   };
  };

  msm_cam_smmu_ife {
   compatible = "qcom,msm-cam-smmu-cb";
