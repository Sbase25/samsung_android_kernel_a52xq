     qcom,gpu-freq = <800000000>;
     qcom,bus-freq = <12>;
     qcom,bus-min = <10>;
     qcom,bus-max = <12>;
    };


    qcom,gpu-pwrlevel@2 {
     reg = <2>;
     qcom,gpu-freq = <650000000>;
     qcom,bus-freq = <10>;
     qcom,bus-min = <8>;
     qcom,bus-max = <12>;
    };


    qcom,gpu-pwrlevel@3 {
