     qcom,bus-freq = <5>;
     qcom,bus-min = <4>;
     qcom,bus-max = <7>;
    };


    qcom,gpu-pwrlevel@7 {
     reg = <7>;
     qcom,gpu-freq = <0>;
     qcom,bus-freq = <0>;
     qcom,bus-min = <0>;
     qcom,bus-max = <0>;
    };
   };

   qcom,gpu-pwrlevels-1 {
